# Copy to `.env` (git-ignored) and adjust. NEVER commit .env or real secrets.
# All values below are local-development placeholders.

# ── Backend (server/) ──
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (Vite dev server).
CORS_ORIGINS=http://localhost:8443

# The application depends ONLY on DATABASE_URL. Docker is optional: point this
# at any PostgreSQL 16 instance.
DATABASE_URL=postgresql://invenzo:change_me_local_only@localhost:5432/invenzo?schema=public
# Used only by the DB test suite. MUST be a different database from DATABASE_URL
# (the test run resets it).
TEST_DATABASE_URL=postgresql://invenzo:change_me_local_only@localhost:5432/invenzo_test?schema=public

# ── docker-compose.yml (optional local PostgreSQL) ──
POSTGRES_USER=invenzo
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=invenzo
POSTGRES_PORT=5432

# ── Frontend (Vite exposes ONLY variables prefixed with VITE_) ──
# Leave unset for pure demo mode. Never put secrets in VITE_ variables.
# VITE_API_BASE_URL=http://localhost:4000
