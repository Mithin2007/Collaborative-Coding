{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @invenzo/server test",
    "server:dev": "pnpm --filter @invenzo/server dev",
    "server:build": "pnpm --filter @invenzo/server build",
    "server:start": "pnpm --filter @invenzo/server start",
    "server:typecheck": "pnpm --filter @invenzo/server typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:validate": "pnpm --filter @invenzo/server prisma:validate",
    "db:generate": "pnpm --filter @invenzo/server prisma:generate",
    "db:migrate": "pnpm --filter @invenzo/server prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @invenzo/server prisma:migrate:deploy",
    "db:status": "pnpm --filter @invenzo/server prisma:migrate:status"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
